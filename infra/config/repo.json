{
  "schema": 1,
  "name": "package-python",
  "kind": "library",
  "workload": "throughput",
  "visibility": "public",
  "platforms": [
    "gitea",
    "github"
  ],
  "features": {
    "ci": true,
    "pages": false,
    "release": true,
    "observability": false
  },
  "limits": {
    "repo_mb": 100,
    "file_mb": 25,
    "max_symlinks": 0
  },
  "ci": {
    "script": "infra/scripts/ci.sh",
    "timeout_minutes": 15,
    "required_jobs": [
      "ci"
    ],
    "primary": "gitea",
    "profile": "python"
  },
  "pages": {
    "enabled": false,
    "output": "public",
    "generator": "docs",
    "publish": {
      "gitea": false
    }
  },
  "binaries": {
    "allowed": [],
    "allow_private_data": false
  },
  "versioning": {
    "scheme": "semver",
    "tag_prefix": "v",
    "release_artifacts": true
  },
  "readme": {
    "max_lines": 80
  },
  "files": {
    "infra_max_file_mb": 1,
    "rules": {
      "": {
        "allow_names": [
          ".dockerignore",
          ".gitattributes",
          ".gitignore",
          "AGENTS.md",
          "README.md",
          "pyproject.toml",
          ".markdownlint.json",
          "VERSION"
        ],
        "allow_globs": []
      },
      "docs/": {
        "allow_extensions": [
          ".md"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "src/": {
        "allow_extensions": [
          ".py"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "infra/config/": {
        "allow_extensions": [
          ".json"
        ]
      },
      ".gitea/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/scoped_workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/": {
        "allow_names": [
          "pull_request_template.md"
        ]
      },
      "docs/issues/": {
        "allow_extensions": [
          ".json",
          ".md"
        ],
        "allow_names": []
      },
      "infra/templates/": {
        "allow": [
          "*"
        ]
      },
      ".gitea/issue_template/": {
        "allow_extensions": [
          ".md",
          ".yml",
          ".yaml"
        ]
      },
      ".github/": {
        "allow_globs": [
          "*"
        ],
        "allow_names": [
          "CODEOWNERS"
        ]
      },
      ".github/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".github/ISSUE_TEMPLATE/": {
        "allow_extensions": [
          ".yml",
          ".yaml",
          ".md"
        ]
      }
    },
    "forbid": [
      {
        "regex": "(^|/)[^/]*\\.md$",
        "reason": "Markdown is allowed only in docs/, .gitea/, README.md, and AGENTS.md",
        "allow": [
          "^README\\.md$",
          "^AGENTS\\.md$",
          "^docs/",
          "^\\.gitea/issue_template/",
          "^\\.gitea/pull_request_template\\.md$",
          "^infra/templates/",
          "^\\.github/"
        ]
      },
      {
        "regex": "^infra/data/",
        "reason": "infra/data is retired; use src/data"
      },
      {
        "regex": "^infra/.*\\.(pdf|png|jpg|jpeg|gif|webp|mp4|mp3|zip|gz|tar|7z)$",
        "reason": "infra is repository management only"
      },
      {
        "regex": "^\\.gitlab-ci\\.yml$",
        "reason": "GitLab is not a source"
      }
    ]
  },
  "organization": "gardusi-gustavo",
  "layer": 2,
  "depends_on": [],
  "consumers": [],
  "data_classification": "public",
  "publish": [
    "pypi"
  ],
  "hubs": {
    "practice": 20,
    "automation": 21
  },
  "dependencies": {
    "gardusi-gustavo/package-sh": "v0.6.3"
  }
}
