{
  "schema": 1,
  "template": {
    "version": 1
  },
  "name": "python-etl",
  "kind": "library",
  "workload": "throughput",
  "visibility": "public",
  "platforms": [
    "gitea"
  ],
  "purpose": "Shared Python extraction, transformation, and loading helpers.",
  "workflows": [
    "ci",
    "release"
  ],
  "integrations": {
    "dockerhub": false,
    "pypi": true,
    "npm": false
  },
  "secrets": [
    "PYPI_API_TOKEN"
  ],
  "features": {
    "ci": true,
    "pages": false,
    "data": false,
    "release": true,
    "observability": false
  },
  "limits": {
    "repo_mb": 100,
    "file_mb": 25,
    "data_file_mb": 50,
    "max_symlinks": 0
  },
  "ci": {
    "dockerfile": "infra/docker/ci.Dockerfile",
    "script": "infra/scripts/ci.sh",
    "timeout_minutes": 15,
    "required_jobs": [
      "ci"
    ],
    "primary": "gitea"
  },
  "release": {
    "mode": "pypi",
    "script": "infra/scripts/release.sh",
    "tag_prefix": "v"
  },
  "pages": {
    "enabled": false,
    "output": "public",
    "generator": "docs",
    "publish": {
      "gitea": false
    }
  },
  "binaries": {
    "allowed": [],
    "allow_private_data": false
  },
  "versioning": {
    "scheme": "semver",
    "tag_prefix": "v",
    "release_artifacts": true
  },
  "readme": {
    "max_lines": 80
  },
  "rules": {
    "src/": {
      "allow": [
        "*"
      ],
      "recursive": true
    },
    "infra/config/": {
      "allow_extensions": [
        ".json"
      ],
      "recursive": false
    },
    "infra/docker/": {
      "allow_globs": [
        "*.Dockerfile"
      ],
      "recursive": false
    },
    "infra/scripts/": {
      "allow_extensions": [
        ".sh"
      ],
      "recursive": true
    },
    "infra/data/": {
      "allow": [
        "*"
      ],
      "allow_names": [
        ".gitkeep"
      ],
      "deny_extensions": [
        ".sh",
        ".py",
        ".go",
        ".js",
        ".ts",
        ".tsx",
        ".rs"
      ],
      "recursive": true
    },
    "docs/": {
      "allow_extensions": [
        ".md"
      ],
      "recursive": true
    },
    ".gitea/workflows/": {
      "allow_extensions": [
        ".yml",
        ".yaml"
      ],
      "recursive": false
    }
  }
}
