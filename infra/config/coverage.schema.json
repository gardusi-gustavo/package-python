{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitea.localhost/templates/json/src/branch/main/schemas/coverage.schema.json",
  "title": "Repository coverage map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "updated",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "status"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "missing",
              "stale"
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "covered",
                    "partial"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
